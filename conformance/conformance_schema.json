{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/conformance_schema.json",
  "title": "A2UI Conformance Test Suite Schema",
  "description": "Generic JSON schema validating all A2UI conformance test suites across core, agent, and extensions domains.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "action"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "Unique name of the test case."
      },
      "action": {
        "type": "string",
        "description": "The conformance test action to perform."
      },
      "description": {
        "type": "string",
        "description": "Optional description of what the test verifies."
      },
      "protocol_version": {
        "type": "string",
        "enum": [
          "v0.8",
          "v0.9",
          "v0.9.1",
          "v1.0"
        ],
        "description": "Target A2UI protocol version."
      },
      "catalog": {
        "description": "Catalog configuration, schema object, or catalog file path string."
      },
      "catalogs": {
        "type": "array",
        "description": "List of catalog configurations for multi-catalog or processor tests."
      },
      "catalog_id": {
        "type": "string",
        "description": "Identifier of the target catalog."
      },
      "catalog_path": {
        "type": "string",
        "description": "File path to catalog schema JSON file."
      },
      "catalog_paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of file paths to catalog schema JSON files."
      },
      "catalog_configs": {
        "description": "Catalog configurations or options."
      },
      "strict_mode": {
        "type": "boolean",
        "description": "Whether strict validation mode is enabled."
      },
      "disable_validation": {
        "type": "boolean",
        "description": "Whether validation is explicitly disabled for the test."
      },
      "input": {
        "description": "Primary input for single-step test execution."
      },
      "inputs": {
        "description": "Alternative batch or multi-part inputs."
      },
      "messages": {
        "description": "A2UI message array or container object."
      },
      "payload": {
        "description": "Test payload data."
      },
      "args": {
        "type": "object",
        "description": "Execution arguments for the test action."
      },
      "format": {
        "description": "Inference format configuration or name."
      },
      "schema": {
        "description": "JSON schema object or path used during execution."
      },
      "surface": {
        "type": "object",
        "description": "Surface state or configuration object."
      },
      "modifiers": {
        "type": "array",
        "description": "Modifiers applied during test execution."
      },
      "steps": {
        "type": "array",
        "description": "Sequential steps for multi-step execution tests.",
        "items": {
          "type": "object",
          "properties": {
            "input": {
              "description": "Input for this step."
            },
            "payload": {
              "description": "Payload for this step."
            },
            "messages": {
              "description": "Messages for this step."
            },
            "chunk": {
              "type": "string",
              "description": "Stream chunk string."
            },
            "args": {
              "type": "object",
              "description": "Arguments for this step."
            },
            "expect": {
              "description": "Expected output for this step."
            },
            "expect_error": {
              "$ref": "#/$defs/ExpectError"
            },
            "expect_contains": {
              "description": "Expected substrings or sub-objects for this step."
            }
          }
        }
      },
      "expect": {
        "description": "Expected outcome of the test action."
      },
      "expect_error": {
        "$ref": "#/$defs/ExpectError"
      },
      "expect_contains": {
        "description": "Expected substrings or sub-objects in the output."
      },
      "expect_empty": {
        "type": "boolean",
        "description": "Whether output is expected to be empty."
      },
      "expect_selected": {
        "type": "string",
        "description": "Expected selected catalog identifier."
      },
      "expect_catalog_schema": {
        "description": "Expected catalog schema object or definition."
      },
      "assertions": {
        "description": "Assertions to verify."
      }
    }
  },
  "$defs": {
    "ExpectError": {
      "description": "Expected error specification (error message string, regex, or structured error object).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
